# IncuBrix Distribution — Environment Variable Template
# Copy this to .env and fill in real values for local development.
# NEVER commit .env to git.
# Credentials below are for LOCAL DEVELOPMENT ONLY — do not use in production.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production | test
APP_HOST=0.0.0.0
APP_PORT=8000
# API Bearer token for authenticating to IncuBrix APIs.
# In production, must be at least 16 chars. Predictable defaults (e.g. change-me-*) are rejected.
API_BEARER_TOKEN=replace-with-your-private-api-bearer-token-16-chars

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# In docker-compose, the app connects via the service name 'db'.
# For local development outside docker, use localhost.
DATABASE_URL=postgresql+asyncpg://incubrix:incubrix_dev_password@localhost:5432/incubrix_dist
DATABASE_URL_SYNC=postgresql+psycopg2://incubrix:incubrix_dev_password@localhost:5432/incubrix_dist
# Test database — safety guard: must end in '_test'
TEST_DATABASE_URL=postgresql+asyncpg://incubrix:incubrix_dev_password@localhost:5432/incubrix_dist_test
# Pool configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── MinIO / S3-compatible storage ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_secret
S3_BUCKET=incubrix-dist
S3_REGION=us-east-1
# Set to 'local' for filesystem fallback (dev only), 's3' for MinIO/AWS
STORAGE_BACKEND=s3

# ── Security ──────────────────────────────────────────────────────────────────
# Required to encrypt stored credentials at rest using Fernet (AES-128-CBC + HMAC-SHA256).
# If missing, storing credentials via the API is rejected.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key-32bytes-base64=

# HMAC-SHA256 signing secret for webhook connector and job callbacks.
# In production, must be at least 16 chars. Predictable defaults are rejected.
HMAC_SIGNING_SECRET=replace-with-your-hmac-signing-secret-16-chars

# ── Connector enable/disable switches ─────────────────────────────────────────
CONNECTOR_DISCOURSE_ENABLED=true
CONNECTOR_LEMMY_ENABLED=true
CONNECTOR_DEVTO_ENABLED=true
CONNECTOR_GHOST_ENABLED=true
CONNECTOR_WEBHOOK_HMAC_ENABLED=true
CONNECTOR_ASSISTED_ENABLED=true

# ── Discourse (local test instance or real) ────────────────────────────────────
DISCOURSE_BASE_URL=http://localhost:4000
DISCOURSE_API_KEY=placeholder-discourse-api-key
DISCOURSE_API_USERNAME=system

# ── Lemmy (local test instance) ───────────────────────────────────────────────
LEMMY_BASE_URL=http://localhost:8536
LEMMY_USERNAME=admin
LEMMY_PASSWORD=placeholder-lemmy-password
LEMMY_COMMUNITY_ID=2

# ── Dev.to ────────────────────────────────────────────────────────────────────
DEVTO_API_KEY=placeholder-devto-api-key
DEVTO_API_BASE_URL=https://dev.to/api

# ── Ghost (local test instance) ───────────────────────────────────────────────
GHOST_ADMIN_API_KEY=placeholder-ghost-admin-api-key
GHOST_CONTENT_API_KEY=placeholder-ghost-content-api-key
GHOST_API_BASE_URL=http://localhost:2368

# ── Outbound HTTP timeouts ────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Simulation mode ───────────────────────────────────────────────────────────
# When true, connectors use mocks and never contact real platforms
SIMULATION_MODE=true
